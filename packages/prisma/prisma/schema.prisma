generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  username String @unique
  password String
}

model Job {
  id       String @id
  username String @unique
  title    String
}

model Address {
  id String @id
  city String 
}